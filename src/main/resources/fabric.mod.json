{
  "schemaVersion": 1,
  "id": "betterhotbarswap",
  "version": "${version}",
  "name": "BetterHotbarSwap",
  "description": "Makes Minecraft's hotkey assignment system more functional and smarter. It also enables a whole new way of using hotkeys.",
  "icon": "assets/betterhotbarswap/icon.png",
  "authors": [
    "B_E_E"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.betterhotbarswap.client.BetterHotbarSwapClient"
    ],
    "modmenu": [
      "com.betterhotbarswap.integration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "betterhotbarswap.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=17"
  },
  "suggests": {
    "modmenu": "*"
  }
}
