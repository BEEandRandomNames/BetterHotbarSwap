{
  "schemaVersion": 1,
  "id": "betterhotbarswap",
  "version": "${version}",
  "name": "BetterHotbarSwap",
  "description": "Smarter hotbar assignment and inventory flow for Minecraft.",
  "authors": ["BetterHotbarSwap Team"],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.betterhotbarswap.client.BetterHotbarSwapClient"
    ],
    "modmenu": [
      "com.betterhotbarswap.integration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "betterhotbarswap.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "1.20.1",
    "java": ">=17"
  },
  "suggests": {
    "modmenu": "*"
  }
}
